# Copy this file to `repo/.env` (next to docker-compose.yml) and fill in values.
RESEARCHKB_HOME=/path/to/research-kb-data
RESEARCHKB_REPORTS=/path/to/reports-fetcher/reports
RESEARCHKB_DISCORD=/path/to/discord_export
# Bind the API to a loopback by default; set a trusted LAN address to expose it.
RESEARCHKB_BIND=127.0.0.1

# Optional: read-only Syncthing status collector (leave defaults generally).
RESEARCHKB_SYNCTHING_GUI=http://127.0.0.1:8384
# Friendly label for the paired Windows device (never shown as a full device id).
RESEARCHKB_SYNCTHING_PEER_ALIAS=Windows Vault
# Optional folder id / explicit peer device id / poll interval (seconds).
RESEARCHKB_SYNCTHING_FOLDER=
RESEARCHKB_SYNCTHING_PEER_ID=
RESEARCHKB_MONITOR_INTERVAL=20
