# Copy this file to `repo/.env` (next to docker-compose.yml) and fill in values.
RESEARCHKB_HOME=/path/to/research-kb-data
RESEARCHKB_REPORTS=/path/to/reports-fetcher/reports
RESEARCHKB_DISCORD=/path/to/discord_export
# Bind the API to a loopback by default; set a trusted LAN address to expose it.
RESEARCHKB_BIND=127.0.0.1
